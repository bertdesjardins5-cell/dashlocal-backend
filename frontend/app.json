{
  "expo": {
    "name": "DashLocal",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.arrivewise.ue3on3",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share live location so customers track deliveries",
        "NSCameraUsageDescription": "Scan parcel labels and photograph deliveries",
        "NSPhotoLibraryUsageDescription": "Attach delivery photos from your gallery"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.arrivewise.ue3on3",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share live location so customers track deliveries"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Photograph parcels as proof of delivery"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan parcel labels and photograph deliveries"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}