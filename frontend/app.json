{
  "expo": {
    "name": "DashLocal",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emergent.arrivewise.ue3on3",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share live location so customers track deliveries",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Auto-mark stops arrived even with phone locked",
        "UIBackgroundModes": [
          "location"
        ],
        "NSCameraUsageDescription": "Scan parcel labels and photograph deliveries",
        "NSPhotoLibraryUsageDescription": "Attach delivery photos from your gallery",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.emergent.arrivewise.ue3on3",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share live location so customers track deliveries",
          "locationAlwaysAndWhenInUsePermission": "Auto-mark stops arrived even with phone locked",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Photograph parcels as proof of delivery",
          "microphonePermission": false,
          "photosPermission": "Attach delivery photos from your gallery"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan parcel labels and photograph deliveries",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { <init>(); }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
